MONGODB_URI=mongodb://127.0.0.1:27017/custex
PORT=3001

# ============================================================================
# Revive AdServer Configuration
# ============================================================================

# Required: Revive instance hostname
REVIVE_HOST=your-revive-instance.com

# Required: API user credentials
REVIVE_USERNAME=api_user
REVIVE_PASSWORD=your_secure_password_here

# Optional: API path (default: /www/api/v2/xmlrpc/)
REVIVE_API_PATH=/www/api/v2/xmlrpc/

# Optional: Use HTTPS/SSL (default: true)
REVIVE_USE_SSL=true

# Optional: Custom port (default: 443 for HTTPS, 80 for HTTP)
REVIVE_PORT=443

# Optional: Request timeout in milliseconds (default: 30000)
REVIVE_REQUEST_TIMEOUT=30000

# Optional: Max retry attempts for transient errors (default: 3)
REVIVE_MAX_RETRIES=3